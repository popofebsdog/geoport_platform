# API 配置
VITE_API_URL=/api
VITE_STATIC_URL=http://localhost:3001
VITE_TITILER_URL=/titiler
# Vite proxy targets must be absolute origins. Public /api and /titiler paths are separate.
VITE_BACKEND_ORIGIN=http://localhost:3001
VITE_TITILER_ORIGIN=http://localhost:8080
# Production Compose supplies http://backend:3001; leave unset for host-only development.
VITE_TITILER_ASSET_ORIGIN=

# Browser application logging is disabled; service diagnostics are on the backend.

# 應用配置
VITE_APP_TITLE=GeoPort 災情資料搜集系統
VITE_APP_VERSION=1.0.0

# 地圖配置
VITE_MAP_API_KEY=your-map-api-key-here

# 文件上傳配置
VITE_MAX_FILE_SIZE=50MB
VITE_ALLOWED_FILE_TYPES=image/*,application/pdf,.csv,.xlsx,.geojson,.shp
