{
  "name": "geoport-fullstack",
  "version": "1.0.0",
  "description": "GeoPort 災情資料搜集系統 - 前後端整合專案",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\" \"npm run dev:titiler\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:titiler": "bash backend/start_titiler.sh",
    "seed": "node backend/database/seed_admin.js",
    "seed:reset": "node backend/database/seed_admin.js --reset",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "npm --prefix backend run build",
    "start": "concurrently \"npm run start:backend\" \"npm run start:frontend\" \"npm run start:titiler\"",
    "start:backend": "cd backend && npm start",
    "start:frontend": "cd frontend && npm run preview",
    "start:titiler": "bash backend/start_titiler.sh",
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install",
    "docker:build": "docker-compose --profile prod build",
    "docker:up": "docker-compose --profile prod up -d",
    "docker:dev": "docker-compose --profile dev up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "ops:check": "node backend/scripts/check-health.js",
    "ops:backup": "bash backend/scripts/backup-bundle.sh",
    "ops:verify-backup": "node backend/scripts/verify-backup.js",
    "release:package": "node scripts/package-release.mjs",
    "test": "npm run test:backend && npm run test:frontend && npm run test:titiler",
    "test:backend": "cd backend && npm test",
    "test:frontend": "cd frontend && npm test",
    "test:titiler": "bash backend/start_titiler.sh --test",
    "clean": "rm -rf node_modules backend/node_modules frontend/node_modules backend/database.sqlite"
  },
  "engines": {
    "node": ">=20.19 <21 || >=22.12 <25"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": [
    "geoport",
    "disaster",
    "monitoring",
    "gis",
    "vue",
    "express",
    "fullstack"
  ],
  "author": "GeoPort Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/geoport.git"
  }
}
