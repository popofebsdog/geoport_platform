# 伺服器
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
TRUST_PROXY=false
LOG_LEVEL=info
LOG_FORMAT=json
LOG_REQUESTS=true
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000

# JWT（請使用強隨機值：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"）
JWT_SECRET=replace-with-strong-random-secret
JWT_EXPIRES_IN=24h

# Admin setup only: set one source, never pass the password as a CLI argument.
# No default password. Production: at least 12 characters; maximum 72 UTF-8 bytes.
# Keep secrets out of git; ADMIN_PASSWORD_FILE points to a mounted secret file.
ADMIN_PASSWORD=
ADMIN_PASSWORD_FILE=

# 資料庫（PostgreSQL）
DB_HOST=localhost
DB_PORT=5432
DB_NAME=geoport_db
DB_USER=postgres
DB_PASSWORD=replace-with-strong-password
DB_SSL=false

# TiTiler
TITILER_INTERNAL_URL=http://localhost:8080

# Storage abstraction
# local is implemented now. s3/gcs are reserved for future adapters.
STORAGE_PROVIDER=local
UPLOADS_ROOT=./uploads
DATA_ROOT=../data
UPLOADS_PUBLIC_PATH=/uploads
DATA_PUBLIC_PATH=/data
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_PUBLIC_BASE_URL=
